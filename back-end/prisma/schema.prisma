generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  idUsuario  Int      @id @default(autoincrement())
  nome       String
  login      String  @unique
  email      String  @unique
  senhaHash  String   
  tipo       String   @default("TECNICO") // 'TECNICO' ou 'GESTOR'
  ativo      Boolean @default(true)
  deletedAt DateTime?
  chamados   Chamado[]
}

model Cliente {
  idCliente   Int      @id @default(autoincrement())
  nome        String
  email       String  @unique
  telefone    String  @unique
  chamados    Chamado[]
}

model Chamado {
  idChamado     Int      @id @default(autoincrement())
  idCliente     Int      
  cliente       Cliente  @relation(fields: [idCliente], references: [idCliente])
  idResponsavel Int?      
  responsavel   Usuario?  @relation(fields: [idResponsavel], references: [idUsuario])
  dataChamado   DateTime @default(now())
  //add dispois titulo        String
  descricao     String   
  idStatus      Int @default(1)     
  status        statusOrdem  @relation(fields: [idStatus], references: [idStatus])
  equipamento   String   
}

model statusOrdem {
  idStatus    Int      @id @default(autoincrement())
  descricao   String
  chamados    Chamado[]
}